# Shopify Storefront API — used on the Render development webshop
# (*.onrender.com). Do not point these at production DNS or kunststof-gevel.nl.
#
# Set the same keys as environment variables on the Render web service
# Dashboard → Environment. Never commit the real storefront token.

SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2025-01

# ActiveCampaign — optioneel.
# Zonder API-url én API-key blijven offerte- en staalaanvragen werken:
# ze krijgen een referentie en worden in het serverlog gezet.
# Met beide sleutels gaat het contact naar ActiveCampaign (contact/sync),
# plus een notitie met de referentie. Lijst-id is optioneel.
# Plak nooit een echte sleutel in git. Zet dezelfde namen op Render
# (Dashboard → Environment). De URL is het accountadres, bijvoorbeeld
# https://jouwaccount.api-us1.com — zonder /api/3.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_LIST_ID=

# Google Places API (New). Optioneel.
# Zonder GOOGLE_PLACES_API_KEY toont de site de statische beoordeling
# (4,9 en 120 beoordelingen) en de bestaande klantcitaten.
# Met de key haalt de server rating en reviews op, gecachet voor 2 uur.
# Zet Places API (New) aan in Google Cloud. De sleutel hoort alleen
# op de server (Render Dashboard, Environment). Nooit in git.
# GOOGLE_PLACE_ID mag leeg: dan geldt Kunststof-gevel.nl op Spinsterlaan.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJpTqzqNL_hy8RDIC8CeY0l9g
