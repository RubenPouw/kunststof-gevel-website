# Shopify Storefront API — used on the Render development webshop
# (*.onrender.com). Do not point these at production DNS or kunststof-gevel.nl.
#
# Set the same keys as environment variables on the Render web service
# Dashboard → Environment. Never commit the real storefront token.

SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2025-01

# ActiveCampaign — optioneel.
# Met API-url én API-key gaat het contact naar ActiveCampaign (contact/sync),
# plus een notitie met de referentie. Lijst-id is optioneel.
# Zonder ActiveCampaign én zonder SMTP_PASS toont het formulier een fout.
# Er wordt dan niets als verzonden gemeld.
# Plak nooit een echte sleutel in git. Zet dezelfde namen op Render
# (Dashboard → Environment). De URL is het accountadres, bijvoorbeeld
# https://jouwaccount.api-us1.com — zonder /api/3.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_LIST_ID=

# Optional Admin API token. Used only when the Storefront cart cannot be created.
# The checkout then makes a Shopify draft order and sends the customer to invoice_url.
# Without this token, a failed cart shows an error and does not pretend an order exists.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Lead mail. At least one of e-mail or ActiveCampaign must succeed, or the form shows an error.
# Default is Google Workspace: smtp.gmail.com, port 587 (STARTTLS) or 465 (implicit TLS).
# From and to are both info@kunststof-gevel.nl. SMTP_PASS is a Google app password.
# LEAD_EMAIL_PROVIDER=auto uses SMTP when SMTP_PASS is set.
# Set the provider to resend or mailersend only when that API key should be used instead.
LEAD_EMAIL_TO=info@kunststof-gevel.nl
LEAD_EMAIL_FROM=info@kunststof-gevel.nl
LEAD_EMAIL_PROVIDER=smtp
RESEND_API_KEY=
MAILERSEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@kunststof-gevel.nl
SMTP_PASS=

# Google Tag Manager. Loaded only after the visitor accepts cookies.
NEXT_PUBLIC_GTM_ID=GTM-N3DQ6G5

# Set to 1 to send X-Robots-Tag: noindex on every response.
# Hosts ending in .onrender.com are noindex without this variable.
NOINDEX=
